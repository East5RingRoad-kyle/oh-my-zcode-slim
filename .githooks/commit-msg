#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
#
# Conventional Commits validator for oh-my-zcode-slim.
# https://www.conventionalcommits.org/en/v1.0.0/
#
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

msg_file="${1:?usage: commit-msg <file>}"
[[ -f "$msg_file" ]] || { echo "commit-msg: $msg_file not found" >&2; exit 1; }

subject="$(head -n 1 "$msg_file")"

# VCS-generated messages that do not follow Conventional Commits.
if printf '%s' "$subject" | grep -Eq '^(Merge |Revert "|Rebase |Squashed commit )'; then
  exit 0
fi

# Conventional Commits: <type>[optional scope][!]: <description>
if printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([^)]+\))?!?: .+'; then
  exit 0
fi

cat >&2 <<EOF
commit-msg: rejected (Conventional Commits required)

First line must be:
  <type>[optional scope][!]: <description>

Valid types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert

Examples:
  fix: enforce full 9-role self-test
  feat(dispatch): fan out independent lanes in parallel
  docs: add CHANGELOG

Got: $subject
EOF
exit 1
